# Copier ce fichier en .env.local et renseigner la valeur.
# .env.local n'est JAMAIS versionné (voir .gitignore).

# URL du worker Cloudflare (proxy SIRI + marées + calendrier — voir worker/).
# Seule variable côté client : les secrets (clé Stormglass, URL iCal privée)
# vivent dans le worker (wrangler secret put STORMGLASS_KEY / ICAL_URL).
VITE_SIRI_PROXY=
